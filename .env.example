# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Vercel Postgres / Neon
POSTGRES_URL=

# Telegram Bot API
# Бот должен быть администратором группы/канала и иметь право писать сообщения.
TELEGRAM_BOT_TOKEN=
# Личный чат или несколько id через запятую (личный id положительный, группа обычно -100...)
TELEGRAM_CHAT_ID=
# Дополнительно: id Telegram-группы (например -1001234567890)
TELEGRAM_GROUP_CHAT_ID=

# Admin panel (/admin)
ADMIN_PASSWORD=change-me
ADMIN_SECRET=long-random-string-for-cookie-signing

# Public site URL (для ссылок в Telegram)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
